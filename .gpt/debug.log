data; otherwise capture data\n        this.data = (isVoid ? undefined : a0) as z.output<D>;\n      }\n    };\n  },\n};\n\n// Usage\nexport const CancelledError = NamedError.create(\"UICancelledError\", z.void());\n// OK:\nthrow new CancelledError();\n```\n\nNotes:\n- Keep data typed as z.output<D>; for z.void() that’s void (assignable from undefined).\n- No broadening of other error constructors; only z.void() becomes zero‑arg.\n\n3) JSON.parse returns unknown: centralize the assertion in one place\nDo the unsafe cast once inside readJSON<T>() so all call sites regain types. Optionally add an overload that accepts a Zod schema for the few critical reads you want runtime validation on.\n\n```ts\nimport { promises as fs } from \"node:fs\";\nimport path from \"node:path\";\nimport { z, ZodTypeAny } from \"zod\";\n\nexport async function readJSON<T>(key: string): Promise<T>;\nexport async function readJSON<S extends ZodTypeAny>(\n  key: string,\n  schema: S\n): Promise<z.infer<S>>;\nexport async function readJSON(\n  key: string,\n  schema?: ZodTypeAny\n): Promise<unknown> {\n  const t = await fs.readFile(path.join(dir, key + \".json\"), \"utf8\");\n  const parsed = JSON.parse(t);\n  return schema ? schema.parse(parsed) : (parsed as unknown as never);\n}\n\n// Example (no code changes at call sites)\nconst info = await Storage.readJSON<MessageV2.Info>(p); // now typed\n\n// Optional guarded read\nconst info2 = await Storage.readJSON(p, MessageV2.InfoSchema); // parsed+typed\n```\n\nThis clears the unknown cascade (~71 errors) without touching call sites. Over time, you can migrate hot paths to the schema overload.\n\n4) “Property X does not exist on type {}” with zod-inferred objects: common causes and quick fixes\nIt’s rarely a tsconfig/moduleResolution issue. In practice, {} leaks in via inference or schema widening. The 80/20 checklist:\n\n- Don’t widen your schema to ZodTypeAny.\n  - Problem:\n    const CfgSchema: z.ZodTypeAny = z.object({ experimental: ... });\n   