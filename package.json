{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch packages/opencode/src/index.ts",
    "build": "pnpm --filter opencode build",
    "test": "pnpm --filter opencode test",
    "typecheck": "pnpm -r run typecheck",
    "stainless": "./scripts/stainless",
    "postinstall": "./scripts/hooks"
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "sst": "3.17.8",
    "tsx": "4.19.4",
    "vitest": "^4.0.17"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sst/opencode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "sharp"
  ],
  "patchedDependencies": {}
}
